{
  "name": "@openmate/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^12.2.0",
    "@openmate/config": "workspace:*",
    "@openmate/llm": "workspace:*",
    "@openmate/memory": "workspace:*",
    "@openmate/tools": "workspace:*",
    "@openmate/core": "workspace:*",
    "@openmate/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/better-sqlite3": "^7.6.11"
  }
}
