{
  "name": "@openmate/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Remi — overlay tamagotchi (Electron), companion 'senza finestra'",
  "author": "Holyn <tools.holyn@gmail.com>",
  "homepage": "https://github.com/renato-milano/remi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "demo": "node demo/demo-daemon.mjs",
    "bundle:daemon": "esbuild ../../packages/daemon/src/entry.ts --bundle --platform=node --format=cjs --target=node22 --outfile=build/daemon/daemon.cjs --external:better-sqlite3 --external:@nut-tree-fork/nut-js --external:@nut-tree-fork/* --external:playwright-core --external:electron --sourcemap",
    "bundle:scene3d": "node scene3d/build.mjs",
    "icons": "png2icons build/icon.png build/icon -allp -i",
    "dist:mac": "pnpm run prepare:installer && electron-builder --mac",
    "dist:win": "pnpm run prepare:installer && electron-builder --win",
    "dist:linux": "pnpm run prepare:installer && electron-builder --linux",
    "dist": "pnpm run prepare:installer && electron-builder ",
    "release": "pnpm run prepare:installer && electron-builder --publish always",
    "test:scene3d": "node scene3d/build.mjs && node scene3d/smoke.mjs && node scene3d/contact-smoke.mjs",
    "prepare:installer": "pnpm -w build && pnpm run bundle:daemon && pnpm run bundle:scene3d && bash ../../packaging/build-whisper.sh"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "better-sqlite3": "^12.2.0",
    "playwright-core": "^1.48.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@openmate/scene3d": "workspace:*",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "png2icons": "^2.0.1",
    "three": "0.180.0"
  }
}
